# Server
PORT=3000

# Splunk HTTP Event Collector
SPLUNK_HEC_ENABLED=true
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_HEC_TOKEN=your-hec-token-here
SPLUNK_HEC_INDEX=main
SPLUNK_HEC_SOURCE=node-app
SPLUNK_HEC_SOURCETYPE=node_app
# Set to false when your Splunk uses a self-signed certificate (local dev)
SPLUNK_HEC_STRICT_SSL=false
